<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Allow plaintext HTTP so the Advanced Console can POST diagnostics to a
      local/dev collector (e.g. http://192.168.x.x:8787). iOS App Transport
      Security blocks non-HTTPS requests by default. This is a personal,
      sideloaded build; if you only ever report to an HTTPS endpoint you can
      remove this key.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- Explain the local-network prompt iOS shows when reaching a LAN server. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Fremio sends diagnostic logs to a collector on your local network.</string>
</dict>
</plist>
